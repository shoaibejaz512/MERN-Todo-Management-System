
{{ define "flowdo.email.subject" }}
[{{ .Status | toUpper }}] {{ .CommonLabels.severity | toUpper }} - FlowDo Monitoring
{{ end }}

{{ define "flowdo.email.html" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
</head>

<body style="margin:0;padding:30px;background:#f3f4f6;font-family:Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0"
    style="max-width:650px;margin:auto;background:#ffffff;
    border-radius:12px;overflow:hidden;">

    <!-- Header -->
    <tr>
      <td style="background:#111827;padding:25px 30px;color:#ffffff;">
        <h1 style="margin:0;font-size:24px;">FlowDo</h1>
        <p style="margin:8px 0 0;color:#9ca3af;">
          Production Monitoring & Alert System
        </p>
      </td>
    </tr>

    <!-- Status -->
    <tr>
      <td style="padding:30px;">

        <h2 style="margin:0 0 15px;color:#111827;">
          {{ if eq .Status "firing" }}
            System Alert Detected
          {{ else }}
            System Issue Resolved
          {{ end }}
        </h2>

        <p style="margin:0 0 20px;color:#6b7280;">
          {{ len .Alerts }} alert(s) reported by FlowDo monitoring.
        </p>

        {{ range .Alerts }}

        <table width="100%" cellpadding="0" cellspacing="0"
          style="border:1px solid #e5e7eb;border-radius:8px;
          margin-bottom:20px;">

          <tr>
            <td style="padding:18px;">

              <p style="margin:0 0 12px;font-size:12px;
                color:#6b7280;text-transform:uppercase;">
                Alert Name
              </p>

              <h3 style="margin:0 0 18px;color:#111827;">
                {{ .Labels.alertname }}
              </h3>

              <p style="margin:0 0 8px;color:#374151;">
                <strong>Status:</strong>
                {{ .Status | toUpper }}
              </p>

              <p style="margin:0 0 8px;color:#374151;">
                <strong>Severity:</strong>
                {{ .Labels.severity | toUpper }}
              </p>

              <p style="margin:0 0 8px;color:#374151;">
                <strong>Service:</strong>
                {{ .Labels.service }}
              </p>

              <p style="margin:0 0 8px;color:#374151;">
                <strong>Instance:</strong>
                {{ .Labels.instance }}
              </p>

              <p style="margin:15px 0 5px;color:#111827;">
                <strong>Description</strong>
              </p>

              <p style="margin:0;color:#6b7280;line-height:1.6;">
                {{ .Annotations.description }}
              </p>

              <p style="margin:15px 0 5px;color:#111827;">
                <strong>Summary</strong>
              </p>

              <p style="margin:0;color:#6b7280;line-height:1.6;">
                {{ .Annotations.summary }}
              </p>

              <p style="margin:15px 0 0;color:#6b7280;font-size:12px;">
                Started:
                {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}
              </p>

              {{ if eq .Status "resolved" }}
              <p style="margin:8px 0 0;color:#16a34a;font-size:12px;">
                Resolved:
                {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}
              </p>
              {{ end }}

            </td>
          </tr>
        </table>

        {{ end }}

        <p style="color:#6b7280;font-size:13px;line-height:1.6;">
          Please investigate the affected service and check application
          logs, Sentry exceptions, and infrastructure health.
        </p>

      </td>
    </tr>

    <!-- Footer -->
    <tr>
      <td style="background:#f9fafb;padding:20px 30px;
        text-align:center;color:#9ca3af;font-size:12px;">

        FlowDo Monitoring System<br>
        Automated notification - Please do not reply.

      </td>
    </tr>

  </table>

</body>
</html>
{{ end }}